# Optional overrides for `npm run dev` / `npm run build`.
# Data fetching always uses the relative /api base (Vite dev proxy → :8000).
# These only affect Swagger/docs links and copied endpoint URLs in Model & API.
# VITE_API_BASE=/api
# VITE_API_URL=http://localhost:8000
# VITE_DOCS_URL=http://localhost:8000/docs
