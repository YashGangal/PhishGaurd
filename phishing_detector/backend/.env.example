DATABASE_URL=sqlite:///./phishguard.db
MODEL_PATH=models/best_model.pkl
MODEL_METADATA_PATH=ml/comparison_report.json
CORS_ORIGINS=http://localhost:5173
ENABLE_HTML_SCRAPING=false
SCRAPER_TIMEOUT_SECONDS=4.0
ALLOW_HEURISTIC_FALLBACK=true
LOG_LEVEL=INFO
# Threat-feed pre-filter (vendored snapshot; refresh via python ml/refresh_blocklist.py)
BLOCKLIST_PATH=ml/data/feed_blocklist.csv
BLOCKLIST_ENABLED=true
# Verdict operating point (frozen gate assumes 0.5 - change deliberately)
DECISION_THRESHOLD=0.5
# Advisory review band on calibrated phishing probability (never changes verdicts)
REVIEW_BAND_LOW=0.4
REVIEW_BAND_HIGH=0.6
